#!/bin/sh
set -eu

MANAGED_DIR="/Library/Application Support/Bears/adapter"
MANAGED_BIN="$MANAGED_DIR/bear-armature"
MANAGED_LEGACY_BIN="$MANAGED_DIR/bears-acp-adapter"
USR_LOCAL_DIR="/usr/local/bin"
USR_LOCAL_BIN="$USR_LOCAL_DIR/bear-armature"
USR_LOCAL_LEGACY_BIN="$USR_LOCAL_DIR/bears-acp-adapter"

if [ ! -x "$MANAGED_BIN" ]; then
  echo "BEARS armature was installed, but $MANAGED_BIN is not executable." >&2
  exit 1
fi

if [ ! -L "$MANAGED_LEGACY_BIN" ] && [ ! -e "$MANAGED_LEGACY_BIN" ]; then
  ln -sf bear-armature "$MANAGED_LEGACY_BIN"
fi

mkdir -p "$USR_LOCAL_DIR"
if [ ! -L "$USR_LOCAL_BIN" ] && [ ! -e "$USR_LOCAL_BIN" ]; then
  ln -sf "$MANAGED_BIN" "$USR_LOCAL_BIN"
fi
if [ ! -L "$USR_LOCAL_LEGACY_BIN" ] && [ ! -e "$USR_LOCAL_LEGACY_BIN" ]; then
  ln -sf "$MANAGED_BIN" "$USR_LOCAL_LEGACY_BIN"
fi

# Avoid running network/config checks here; installs should succeed before the user has credentials.
"$MANAGED_BIN" --version >/dev/null 2>&1 || {
  echo "BEARS armature was installed, but --version failed." >&2
  exit 1
}

cat <<'MESSAGE'
BEARS armature installed successfully.

Next steps:
  1. Configure your ACP client to run /Library/Application Support/Bears/adapter/bears-acp-adapter acp.
     New path /Library/Application Support/Bears/adapter/bear-armature also works.
     Convenience path /usr/local/bin/bear-armature is created when possible.
  2. Provide DEN_API_URL, BEAR_SLUG, and DEN_TOKEN in the client environment.
  3. Run bear-armature doctor from the same environment to validate setup.
MESSAGE

exit 0
