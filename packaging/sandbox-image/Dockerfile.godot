# Godot toolchain sandbox image: the base headless-armature image plus the
# Godot editor binary (usable with `godot --headless`) and export templates,
# for game work surfaces with headless test runs.
#
#   docker build -f packaging/sandbox-image/Dockerfile.godot \
#       --build-arg BASE_IMAGE=bears/sandbox:latest \
#       --build-arg GODOT_VERSION=4.3 \
#       -t bears/sandbox-godot:latest packaging/sandbox-image

ARG BASE_IMAGE=bears/sandbox:latest
FROM ${BASE_IMAGE}

ARG GODOT_VERSION=4.3
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends unzip libfontconfig1 \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL -o /tmp/godot.zip \
        "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_linux.x86_64.zip" \
    && unzip -q /tmp/godot.zip -d /tmp \
    && mv "/tmp/Godot_v${GODOT_VERSION}-stable_linux.x86_64" /usr/local/bin/godot \
    && chmod +x /usr/local/bin/godot \
    && rm -f /tmp/godot.zip \
    && godot --version

# Export templates land in the bear user's data dir so in-sandbox exports work.
USER bear
RUN mkdir -p "/home/bear/.local/share/godot/export_templates/${GODOT_VERSION}.stable" \
    && curl -fsSL -o /tmp/templates.tpz \
        "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_export_templates.tpz" \
    && unzip -q /tmp/templates.tpz -d /tmp/templates \
    && mv /tmp/templates/templates/* "/home/bear/.local/share/godot/export_templates/${GODOT_VERSION}.stable/" \
    && rm -rf /tmp/templates.tpz /tmp/templates

WORKDIR /workspace
ENTRYPOINT ["bear-armature", "headless"]
