# Required deployment-specific values
JWT_SECRET=SETME
OPENAI_API_KEY=SETME
WEB_SERVER_URL=SETME

DEFAULT_LLM_MODEL=openai/gpt-4o-mini
# Per-Bear SQLite store (native runtime). Compose mounts bears-den-sqlite-data here.
BEAR_SQLITE_DATA_DIR=/var/lib/den/bear-sqlite

# Optional compose profiles
# COMPOSE_PROFILES=bundled

# Den database
# Managed Postgres is preferred. If you use COMPOSE_PROFILES=bundled, set this to:
# postgres://bears:bears@bears-postgres:5432/den?sslmode=disable
DATABASE_URL=SETME
DB_MAX_CONNECTIONS=5
DB_ACQUIRE_TIMEOUT_SECS=3
DB_IDLE_TIMEOUT_SECS=600
SQLX_MIGRATE_IGNORE_MISSING=false

# Bifrost model gateway
BIFROST_IMAGE=bears-bifrost:configured
BIFROST_APP_HOST=0.0.0.0
BIFROST_APP_PORT=8080
BIFROST_LOG_LEVEL=info
BIFROST_LOG_STYLE=json
BIFROST_BASE_URL=http://bears-bifrost:8080
LLM_API_URL=http://bears-bifrost:8080/v1

# Den web/API service
# Local tag assigned to the compose-built Den image.
DEN_IMAGE=bears-den:local
DEN_PORT=3000
DEN_API_PORT=3001
APP_DISPLAY_NAME="Bear Den"
APP_SLUG=bears-den
RUN_WEB=true
RUN_API=false
RUN_WORKERS=false
RUST_LOG=info
API_SERVER_URL=https://api.bears.artificial.design
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=true
TEMPLATES_DIR=src/web/templates

# Optional derived recall index (ADR-0038). Enable with COMPOSE_PROFILES=recall and set
# QDRANT_URL=http://bears-qdrant:6333. Empty QDRANT_URL keeps recall disabled (LIKE fallback).
# QDRANT_IMAGE=qdrant/qdrant:v1.12.4
# QDRANT_LOG_LEVEL=INFO
QDRANT_URL=
EMBEDDING_STANDARD=bears-embed-v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional Den pair-role web search provider.
# Set DEN_SEARCH_PROVIDER=brave and BRAVE_SEARCH_API_KEY to enable den.web.search.
DEN_SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
DEN_SEARCH_MAX_RESULTS=5

# Den email
MAIL_FROM_ADDRESS=noreply@bears.artificial.design
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Den S3-compatible object storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# Den GHCR status checks
GITHUB_PACKAGES_TOKEN=
GHCR_PACKAGES_OWNER=
GHCR_PACKAGES_OWNER_KIND=

# Volume backup profile (`COMPOSE_PROFILES=volume-backup`)
DEN_SQLITE_VOLUME_BACKUP_CRON="0 5 * * *"
SCALEWAY_BACKUP_BUCKET=
SCALEWAY_BACKUP_PREFIX=bears-stack/volumes/bears-den-sqlite-data
SCALEWAY_ACCESS_KEY=
SCALEWAY_SECRET_KEY=
SCALEWAY_S3_ENDPOINT=s3.fr-par.scw.cloud
SCALEWAY_REGION=fr-par

# Shared secret for internal API endpoints (optional; empty disables internal auth).
# DEN_INTERNAL_TOKEN=
