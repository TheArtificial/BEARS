#!/bin/bash
# Repository pre-commit checks.
set -euo pipefail

MAX_DELETES="${MAX_COMMIT_DELETES:-10}"
AUTO_BUMP_DEN_PATCH="${AUTO_BUMP_DEN_PATCH:-$(git config --bool hooks.autoBumpDenPatch 2>/dev/null || true)}"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exit 0
fi

# SQLx offline metadata is generated as a cache. A metadata refresh commonly
# replaces many files, so do not let its stale-file cleanup mask a bulk source
# deletion. Every other staged deletion remains subject to the safety limit.
staged_deletes="$(
  git diff --cached --name-status 2>/dev/null |
    awk -F '\t' '$1 ~ /^D/ && $2 !~ /(^|\/)\.sqlx\// { c++ } END { print c + 0 }'
)"

if [ "${staged_deletes}" -gt "${MAX_DELETES}" ]; then
  cat >&2 <<EOF
pre-commit: refusing commit with ${staged_deletes} staged non-SQLx file deletions (limit ${MAX_DELETES}).

This usually means an agent tried to "remove deprecated" files in bulk.
Review with: git diff --cached --name-status | awk '/^D/'
To override once: MAX_COMMIT_DELETES=${staged_deletes} git commit ...
EOF
  exit 1
fi

./scripts/check-sqlx-migration-prefixes.sh --staged

case "${AUTO_BUMP_DEN_PATCH}" in
  true|1|yes|on)
    den_manifest="services/den/Cargo.toml"
    if git diff --cached --quiet -- "${den_manifest}" && git diff --quiet -- "${den_manifest}"; then
      ./scripts/bump-den-version.sh patch >&2
      git add "${den_manifest}"
    else
      echo "pre-commit: ${den_manifest} already changed; skipping automatic Den patch bump" >&2
    fi
    ;;
esac

needs_sqlx_offline_check=0
while IFS= read -r -d '' file; do
  case "${file}" in
    services/den/Cargo.toml|services/den/Cargo.lock|services/den/migrations/*|services/den/.sqlx/*|services/den/*.sql)
      needs_sqlx_offline_check=1
      break
      ;;
    *.rs)
      if git cat-file -e ":${file}" 2>/dev/null &&
        git show ":${file}" | grep -Eq '(^|[^[:alnum:]_])sqlx::(query|query_as|query_scalar|query_file|query_file_as|query_file_scalar)!'; then
        needs_sqlx_offline_check=1
        break
      fi
      ;;
  esac
done < <(git diff --cached --name-only -z)

if [ "${needs_sqlx_offline_check}" -eq 1 ]; then
  echo "pre-commit: verifying staged Den SQLx metadata compiles offline" >&2
  SQLX_OFFLINE=true cargo check --manifest-path services/den/Cargo.toml --locked --features=production
fi

# ponytail: this staged-file heuristic does not expand Rust macros or trace query
# strings through wrappers. The Den image build remains the non-bypassable backstop.
