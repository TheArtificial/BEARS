{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT ub.user_id, u.username, u.display_name, ub.role\n        FROM user_bear ub\n        INNER JOIN users u ON u.id = ub.user_id\n        WHERE ub.bear_id = $1\n        ORDER BY\n            CASE WHEN lower(btrim(coalesce(ub.role, ''))) = 'admin' THEN 0 ELSE 1 END,\n            u.username\n        ",
