{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            bear_slug,\n            current_mode,\n            count(*) AS sessions,\n            count(*) FILTER (WHERE closed_at IS NULL) AS open_sessions,\n            max(updated_at) AS last_updated_at\n        FROM client_sessions\n        GROUP BY bear_slug, current_mode\n        ORDER BY bear_slug, current_mode\n        ",
