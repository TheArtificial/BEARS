  "query": "\n        SELECT\n            trigger,\n            status,\n            policy_version,\n            source_group_start,\n            source_group_end,\n            diagnostic,\n            artifact,\n            to_char(created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.MS\"Z\"') AS \"created_at!\"\n        FROM runtime_compaction_events\n        WHERE conversation_id = $1\n        ORDER BY created_at DESC\n        LIMIT $2\n        ",
