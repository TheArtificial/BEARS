{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, sequence_no, session_id, event_type, event_json, created_at\n        FROM bearwire_events\n        WHERE session_id = $1\n          AND ($2::bigint IS NULL OR sequence_no > $2)\n        ORDER BY sequence_no ASC\n        LIMIT $3\n        ",
