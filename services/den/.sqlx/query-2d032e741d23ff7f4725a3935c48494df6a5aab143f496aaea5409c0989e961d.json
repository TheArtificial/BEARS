{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT ub.user_id, u.username, ub.bear_id, b.slug AS bear_slug, b.name AS bear_name, ub.role\n        FROM user_bear ub\n        INNER JOIN users u ON u.id = ub.user_id\n        INNER JOIN bears b ON b.id = ub.bear_id\n        ORDER BY u.username, b.slug\n        ",
