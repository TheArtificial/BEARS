{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, run_id, step_index, state, provider_response_id, opened_at, closed_at\n        FROM turn_steps\n        WHERE run_id = $1\n          AND state IN ('streaming_model', 'waiting_for_client', 'ready_to_continue')\n        ORDER BY step_index DESC\n        LIMIT 1\n        ",
