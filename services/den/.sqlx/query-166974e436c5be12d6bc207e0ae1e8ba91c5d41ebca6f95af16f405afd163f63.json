  "query": "\n        SELECT id, run_id, session_id, bear_id, user_id, state,\n               terminal_reason AS \"terminal_reason?\", created_at, updated_at,\n               completed_at AS \"completed_at?\"\n        FROM turn_runs\n        WHERE state = 'failed'\n        ORDER BY completed_at DESC NULLS LAST, updated_at DESC\n        LIMIT $1\n        ",
