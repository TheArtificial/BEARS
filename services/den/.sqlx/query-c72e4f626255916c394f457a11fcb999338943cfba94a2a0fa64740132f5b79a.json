  "query": "\n        UPDATE turn_steps\n        SET state = $2,\n            closed_at = CASE WHEN $3 THEN COALESCE(closed_at, NOW()) ELSE closed_at END\n        WHERE id = $1\n        RETURNING id, run_id, step_index, state, provider_response_id, opened_at, closed_at\n        ",
