{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id,\n               a.scope_kind,\n               a.scope_value,\n               a.source,\n               u.username AS \"username?\",\n               NULLIF(u.display_name, '') AS display_name,\n               a.created_at,\n               a.expires_at\n        FROM bear_web_approvals a\n        LEFT JOIN users u ON u.id = a.approved_by_user_id\n        WHERE a.bear_id = $1 AND a.revoked_at IS NULL\n        ORDER BY a.created_at DESC\n        ",
