# Runtime environment — hello world / smoke deploy
#
# Copy to `.env` for local runs (`cargo run` loads `.env` via dotenvy), or set
# these keys in your orchestrator (Kubernetes, Docker `-e`, systemd `Environment=`, etc.).
#
# PostgreSQL dependency
# ---------------------
# The app does not start postgres for you. Provision Postgres and create a database
# (empty is fine). On startup, `den` applies SQLx migrations under `migrations/` to
# this DATABASE_URL automatically.

DATABASE_URL=SETME

# Database pool tuning (defaults are fine for most single-instance deployments).
# DB_MAX_CONNECTIONS=5
# DB_ACQUIRE_TIMEOUT_SECS=3
# DB_IDLE_TIMEOUT_SECS=600

# SQLx migrations: default is strict (every row in `_sqlx_migrations` must match files in `migrations/`).
# Set only for documented recovery when the DB lists migrations that were renamed/removed from the repo:
# SQLX_MIGRATE_IGNORE_MISSING=true

# Service toggles — enable at least one or the process will do little useful work.
RUN_WEB=true
RUN_API=false
RUN_WORKERS=false
# Sandbox provider service — hosts isolated workspaces where headless armatures
# execute Docket work. May run standalone on a separate host; when it is the only
# enabled service, DATABASE_URL is not required.
RUN_SANDBOX=false
RUST_LOG=info

PORT=3000
API_PORT=3001
# SANDBOX_PORT=3002

# Sandbox provider settings (the RUN_SANDBOX process reads these).
# Static bearer token for the /sandbox/v1 API; empty disables auth (dev only).
# SANDBOX_SERVICE_TOKEN=
# JSON file declaring syncable workspace roots (see docs/roadmap/sandbox_brief.md).
# SANDBOX_ROOTS_CONFIG=./data/sandbox-roots.json
# SANDBOX_WORKSPACES_DIR=./data/sandbox-workspaces
# Default container image for sandboxes (built via scripts/build-sandbox-image.sh).
# SANDBOX_IMAGE=bears/sandbox:latest
# SANDBOX_MAX_CONCURRENT=2
# SANDBOX_DEFAULT_TIMEOUT_SECS=900
# SANDBOX_MAX_LOG_BYTES=2097152

# Work dispatch settings (the Den instance dispatching work reads these).
# Base URL of the sandbox provider; unset disables work dispatch.
# SANDBOX_SERVER_URL=http://bears-sandbox:3002
# SANDBOX_SERVER_TOKEN=
# Den API URL as reachable from inside sandbox containers (defaults to API_SERVER_URL).
# SANDBOX_CALLBACK_API_URL=http://host.docker.internal:3001
# WORK_DISPATCH_AUTO=false
# SANDBOX_PRESERVE_FAILED=false
# WORK_MAX_ATTEMPTS=2

# Native agent runtime (default). Requires LLM_API_URL (Bifrost).
AGENT_RUNTIME=native
# BEAR_SQLITE_DATA_DIR=/var/lib/den/bear-sqlite

# Branding (human title, PWA id / short name). Forks should set these.
# APP_DISPLAY_NAME=BEARS Den
# APP_SLUG=bears-den

# Optional: canonical public URLs (no trailing slash). In root compose deploys,
# prefer DEN_WEB_ORIGIN / DEN_API_ORIGIN and let WEB_SERVER_URL / API_SERVER_URL derive.
# Production builds default to this repo’s deployment hostname; override for your fork:
# DEN_WEB_ORIGIN=https://bears.artificial.design
# DEN_API_ORIGIN=https://api.bears.artificial.design
# WEB_SERVER_URL=https://bears.artificial.design
# API_SERVER_URL=https://api.bears.artificial.design
# WEB_SERVER_URL=http://localhost:3000
# API_SERVER_URL=http://localhost:3001

# Optional: RFC 5322 From address for outbound mail (default noreply@<WEB host> when host is not localhost, else unset fallback in code).
# MAIL_FROM_ADDRESS=noreply@bears.artificial.design

# Optional: session cookie Domain (production builds only). Omit for host-only cookies.
# SESSION_COOKIE_DOMAIN=.example.com

# Optional mail — leave empty for hello world
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# Optional: template path override (usually only for custom images/layouts)
# TEMPLATES_DIR=src/web/templates

# OAuth JWT signing (HS256). Required when RUN_API=true, or when the binary is built with `--features production`
# (Coolify / release images use production). Web-only local runs may omit this; a dev default is used only if the API is off.
JWT_SECRET=SETME

# Bifrost / LLM gateway — required for native runtime. In root compose deploys,
# prefer BIFROST_ORIGIN and let BIFROST_BASE_URL / BIFROST_MANAGEMENT_URL / LLM_API_URL derive.
# Use distinct BIFROST_APP_PORT values per environment if multiple stacks share a Docker network.
# BIFROST_ORIGIN=http://bears-bifrost:8080
# LLM_API_URL=http://bears-bifrost:8080/v1
# BIFROST_BASE_URL=http://bears-bifrost:8080
# BIFROST_MANAGEMENT_URL=http://bears-bifrost:8080/api

# S3-compatible object storage — Garage (artifacts: agent outputs, uploads, routine files). Leave endpoint empty to disable.
# See ../../docs/artifacts-garage-adr.md — Cabinet/Outline uses bucket bears-cabinet (separate; Phase 2+).
# S3_ENDPOINT=http://localhost:3900
# S3_BUCKET=bears-artifacts
# S3_REGION=garage
# S3_ACCESS_KEY_ID=<garage key id>
# S3_SECRET_ACCESS_KEY=<garage secret key>
# S3_PUBLIC_URL=http://localhost:3900
# S3_FORCE_PATH_STYLE=true

# Optional: GitHub Packages (GHCR) — when set, `GET /status` compares running Den `git_sha` to registry tags
# GITHUB_PACKAGES_TOKEN=<PAT with read:packages>
# GHCR_PACKAGES_OWNER=your-org-or-user
# GHCR_PACKAGES_OWNER_KIND=
